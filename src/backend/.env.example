# Django settings
DJANGO_DEBUG=True

# Database switch:
# - If DB_NAME is set, backend uses PostgreSQL.
# - If DB_NAME is empty/unset, backend falls back to SQLite (src/backend/db.sqlite3).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=vop
DB_USER=vop_user
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=5432
